# PostgreSQL connection string used to store shared letter snapshots.
# Any PostgreSQL-compatible provider works (Neon, Railway, RDS, Crunchy, self-hosted...).
# Add ?sslmode=require for hosted providers that need TLS.
DATABASE_URL=postgres://user:password@host:5432/dearly

# Public origin used when building share URLs (optional — falls back to the request origin).
NEXT_PUBLIC_SITE_URL=https://dearly.app

# Development only: when DATABASE_URL is not set, `next dev` uses an embedded on-disk
# PostgreSQL (PGlite) stored in ./.data/pglite. Set to 1 to disable that fallback.
# DEARLY_DISABLE_DEV_DB=1
